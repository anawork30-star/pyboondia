# Copia este archivo a .env.local (está en .gitignore). NUNCA subas valores reales a GitHub.
# Las variables VITE_* se incrustan en el JavaScript público del sitio: solo pon aquí datos públicos.

# --- Sitio de la agencia (Vite) ---------------------------------------------------------------
VITE_SITE_URL=https://www.aiduoficial.com

# Supabase: URL del proyecto y clave anon/publishable (es pública por diseño; la protege RLS).
# NUNCA uses aquí la service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Contacto público (si se dejan vacíos, el sitio oculta ese canal).
VITE_CONTACT_EMAIL=
VITE_WHATSAPP_NUMBER=            # formato internacional sin "+" ni espacios, p. ej. 57300XXXXXXX
VITE_LEGAL_NAME=                 # razón social que aparece en el pie y la política de datos
VITE_CITY=

# Redes sociales (URLs completas; vacías = no se muestran).
VITE_INSTAGRAM_URL=
VITE_LINKEDIN_URL=
VITE_TIKTOK_URL=
VITE_BEHANCE_URL=

# --- Código heredado de la tienda (Next.js, carpeta src/app) -----------------------------------
# No lo usa el sitio actual (Vite). Se conserva como referencia por si se retoma el panel /admin.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=        # solo servidor
MERCADOPAGO_ACCESS_TOKEN=         # TEST-... en desarrollo, APP_USR-... en producción
MERCADOPAGO_WEBHOOK_SECRET=       # clave secreta de webhooks del panel de Mercado Pago
NEXT_PUBLIC_WHATSAPP_NUMBER=573106340725
FIRST_ADMIN_EMAIL=ana.work30@gmail.com
